worker_processes 1;

events {
    worker_connections 1024;
}

http {
    include         mime.types;
    default_type    application/octet-stream;

    sendfile        on; 

    server {
        listen       443 ssl;
        server_name  localhost;

        ssl_certificate         C:/nginx/ssl/nginx.pem;
        ssl_certificate_key     C:/nginx/ssl/nginx.pem;

        location / {
            root   html;
            index  index.html index.htm;
        }
    }
}